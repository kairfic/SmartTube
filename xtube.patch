diff --git a/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/xtube/SecondSubtitlePicker.java b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/xtube/SecondSubtitlePicker.java
